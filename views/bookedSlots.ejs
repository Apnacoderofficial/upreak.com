<%- include('includes/header') %>
<title><%= title%> - Upreak A leading recruitment company</title>
<!-- Content -->
<main class="main">

    <%- include('includes/user_header') %>

    <section class="section-box mt-80">
        <div class="container">
            <div class="row flex-row-reverse">
                <div class="col-lg-9 col-md-12 col-sm-12 col-12 float-right">
                    <div class="content-page">
                        <div class="box-filters-job mt-15 mb-10">
                            <div class="row">
                                <div class="col-lg-7">
                                    <span class="text-small fs-3">
                                        <%= title %>
                                    </span>
                                </div>

                                <div class="col-lg-5 text-lg-end mt-sm-15">
                                    <div class="display-flex2">
                                        <div class="box-view-type">
                                            <a href="job-list" class="view-type"><img
                                                    src="/assets/imgs/theme/icons/icon-list.svg" alt="jobhub" /></a>
                                            <!-- <a href="job-list" class="view-type"><img src="/assets/imgs/theme/icons/icon-grid.svg" alt="jobhub" /></a> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="job-list-list mb-15">
                            <div class="list-recent-jobs">
                                <div class="table-responsive">
                                    <table class="table table-striped display expandable-table" id="myTable2">
                                        <thead class="table-light">
                                            <tr>
                                                <th>SNo.</th>
                                                <th>Name</th>
                                                <th>Start Time</th>
                                                <th>End Time</th>
                                                <th>Meeting Status</th>
                                                <th>Report Status</th>
                                                <th>Link</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if(slots.length > 0) { %>
                                                <% for(var i = 0; i < slots.length; i++) { if(slots[i].status == 'Booked') { %>
                                                    <tr>
                                                        <td><%= i+1 %></td>
                                                        <td><%= slots[i].username %></td>
                                                        <td><%= moment(slots[i].start_time).format("MM/DD/YYYY, h:mm:ss A") %></td>
                                                        <td><%= moment(slots[i].end_time).format("MM/DD/YYYY, h:mm:ss A") %></td>
                                                        <td><%= slots[i].status %></td>
                                                        <td><%= slots[i].process_status == 1 ? 'Saved' : 'Not Saved' %></td>
                                                        <td><a href="<%= slots[i].meeting_link %>">Link</a></td>
                                                        <td>
                                                            <a class="btn m-1 btn-outline-warning reschedule-btn" href=""
                                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Reschedule"
                                                                data-row-id="<%= slots[i].id %>"
                                                                data-application-id="<%= slots[i].application_id %>"
                                                                data-end-time="<%= slots[i].end_time %>">
                                                                <i class="bi bi-arrow-clockwise"></i>
                                                            </a>
                                                            <a class="btn m-1 btn-outline-primary" href="add_report?id=<%= slots[i].id %>"
                                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Report">
                                                                <i class="bi bi-card-checklist"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% } } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center">No Data Found</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Include DataTables CSS and JS -->
                                <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css">
                                
                                <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                                <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
                                
                                <!-- DataTable Initialization -->
                                <script>
                                    $(document).ready(function() {
                                        $('#myTable2').DataTable(); // Initialize DataTable
                                    });
                                </script>
                                
                            </div>
                        </div>

                    </div>
                </div>
                <%- include('includes/sidebar') %>
            </div>
        </div>
    </section>


    <%- include('includes/footer') %>