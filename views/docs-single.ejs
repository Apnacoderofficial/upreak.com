<%- include('includes/header') %>

<title><%= blog.title %> - A leading recruitment company</title>

<style>
    .blog span ,
    .blog  p{
        font-size: 20px !important;
        line-height:2;
    }
    .blog h1{
        font-size: 30px !important;
    }
    .blog h2,
    .blog h3{
        font-size: 25px !important;
    }
</style>
    <!-- Content -->
    <main class="main">
        <div class="breacrumb-cover">
            <div class="container">
                <ul class="breadcrumbs">
                    <li><a href="#">Home</a></li>
                    <li>Docs</li>
                </ul>
            </div>
        </div>
        <div class="archive-header pt-50 pb-50 text-center">
            <div class="container">
                <h3 class="mb-30 text-center w-75 mx-auto">
                    <%= blog.title %>
                </h3>
                <div class="post-meta text-muted d-flex align-items-center mx-auto justify-content-center">
                    <div class="author d-flex align-items-center mr-30">
                        <img alt="jobhub" src="assets/imgs/avatar/ava_16.png" />
                        <span>Upreak , Inc</span>
                    </div>
                    <div class="date mr-30">
                        <span><i class="fi-rr-edit mr-5 text-grey-6"></i><%= blog.createdAt %></span>
                    </div>
                    <div class="icons">
                        <a href="#"><i class="fi fi-rr-bookmark mr-5 text-muted"></i></a>
                        <a href="#"><i class="fi fi-rr-heart text-muted"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="post-loop-grid">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="single-body">
                            <figure class="mb-30">
                                <img src="<%= blog.photo ? 'https://portal.upreak.com/uploads/' + blog.photo : 'assets/imgs/blog/thumb-1.png' %>" alt="">
                            </figure>
                            <div class="blog">
                                <%- blog.description %>
                            </div>
                            <div class="single-content">
                            
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('includes/footer') %>