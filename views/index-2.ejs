                                        <a href="/job-details?jobId=<%= locals[i].job_id %>">
                                            <figure><img alt="jobhub" src="assets/imgs/page/job/digital.png" /></figure>
                                        </a>
                                    </div>
                                    <div class="card-job-top--info">
                                        <h6 class="card-job-top--info-heading"><a href="/job-details?jobId=<%= locals[i].job_id %>"><%= locals[i].heading %></a></h6>
                                        <div class="row">
                                            <div class="col-md-9">
                                                <a href="job-details?jobId=<%= locals[i].job_id %>"><span class="card-job-top--company">Upreak, Inc</span></a>
                                                <span class="card-job-top--location text-sm"><i class="fi-rr-marker"></i> <%= locals[i].location %>, India</span>
                                                <span class="card-job-top--type-job text-sm"><i class="fi-rr-briefcase"></i><%= locals[i].job_type %></span>
                                                <span class="card-job-top--post-time text-sm"><i class="fi-rr-clock"></i><span class="card-time"><%= timeAgo %></span></span>
                                            </div>
                                            <div class="col-md-3 text-md-end text-start">
                                                <!-- <span class="card-job-top--price"><%= locals[i].amount %></span> -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-job-description mt-20">
                                    <% 
    // Helper function to truncate description to approximately 40 words
    function truncateDescription(description, wordLimit) {
        const words = description.split(/\s+/);
        if (words.length > wordLimit) {
            return words.slice(0, wordLimit).join(' ') + '...';
        }
        return description;
    }

    // Truncate description to 40 words
    const truncatedDescription = truncateDescription(locals[i].description, 20);
%>

<%- truncatedDescription %>

                                </div>
                                <div class="card-job-bottom mt-25">
                                    <div class="row">
                                        <div class="col-lg-9 col-sm-8 col-12">
                                            <% if (diffDays <= 3) { %>
                                                <a href="/job-details?jobId=<%= locals[i].job_id %>" class="btn btn-small background-urgent btn-pink mr-5">Actively Hiring</a>
