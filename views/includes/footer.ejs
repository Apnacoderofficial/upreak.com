                <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

                <script>
                    $(document).ready(function () {
                        console.log("Document ready"); // To check if document is ready

                        $('.subscription-form').on('submit', function (e) {
                            e.preventDefault(); // Prevent the default form submission
                            console.log(
                                "Form submission prevented"); // Check if submit event is captured

                            const email = $('.email-input').val(); // Select the email input using class
                            console.log("Email entered:",
                                email); // Check if the email is being captured

                            $.ajax({
                                type: 'POST',
                                url: '/subscribe', // Your API endpoint
                                data: JSON.stringify({
                                    email: email
                                }),
                                contentType: 'application/json',
                                success: function (response) {
                                    console.log("AJAX success response:",
                                        response); // Log success response
                                    toastr.success('Subscribed successfully!');
                                    $('.email-input').val(
                                        ''
                                    ); // Clear the input field after successful subscription
                                },
                                error: function (xhr) {
                                    console.log("AJAX error response:",
                                        xhr); // Log error response
                                    const errorMessage = xhr.responseJSON ? xhr.responseJSON
                                        .message : 'An error occurred';
                                    if (errorMessage.includes(
                                            'Email is already subscribed')) {
                                        toastr.warning('This email is already subscribed.');
                                    } else {
                                        toastr.error('Subscription failed: ' +
                                            errorMessage);
                                    }
                                }
                            });
                        });
                    });
                </script>

            </div>
        </div>
