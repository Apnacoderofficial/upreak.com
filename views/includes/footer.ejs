<!-- company enquiry modal -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Handle modal show event
        const modalElement = document.getElementById('enquiryModal');
        const planInput = document.getElementById('plan-choosen');

        // Add event listener for when the modal is shown
        modalElement.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget; // Button that triggered the modal
            const plan = button.getAttribute('data-plan-choosen'); // Get data-plan-choosen value
            if (planInput) {
                planInput.value = plan; // Set value to hidden input
            }
        });

        const enquiryForm = document.getElementById('enquiryForm');

        enquiryForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(enquiryForm);

            try {
                const response = await fetch('/submit-enquiry', {
                    method: 'POST',
                    body: JSON.stringify({
                        category: formData.get('category'),
                        name: formData.get('name'),
                        email: formData.get('email'),
                        phone: formData.get('phone'),
                        cname: formData.get('cname'),
                        cloc: formData.get('cloc'),
                        plan: formData.get(
                        'plan'), // Add the selected plan to the request
                        message: `Company Name: ${formData.get('cname')}, Company Location: ${formData.get('cloc')}`, // Combined message
                    }),
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                const result = await response.json();

                if (result.success) {
                    toastr.success('Enquiry sent successfully!');
                    enquiryForm.reset();
                    document.querySelector('.btn-close').click(); // Close the modal
                } else {
                    toastr.error('Failed to send the enquiry. Please try again.');
                }
            } catch (error) {
                toastr.error('An error occurred. Please try again.');
            }
        });
    });
</script>

