<script>
    // Get modal element
    var modal = document.getElementById("employerModal");

    // Get the button that opens the modal
    var btn = document.getElementById("employer-signin");

    // Get the <span> element that closes the modal
    var span = document.getElementsByClassName("close")[0];

    // When the user clicks the button, open the modal
    btn.onclick = function () {
        modal.style.display = "block";
    }

    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        modal.style.display = "none";
    }

    // When the user clicks anywhere outside of the modal, close it
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>
<script>
    $(document).ready(function () {
        $("#employer-signin").click(function () {
            $("#employerModal").fadeIn();
        });

        $(".close").click(function () {
            $("#employerModal").fadeOut();
        });

        $(window).click(function (event) {
            if (event.target.id === "employerModal") {
                $("#employerModal").fadeOut();
            }
        });
    });
</script>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Get references to the content sections
        const phase1Content = document.getElementById('phase1-content');
        const phase2Content = document.getElementById('phase2-content');
        const phase3Content = document.getElementById('phase3-content');

        // Hide all phases initially except phase 1
        phase2Content.style.display = 'none';
        phase3Content.style.display = 'none';

        // Get the buttons by ID
        const buttonLoginPassword = document.getElementById('button-login-password');
        const buttonSignup = document.getElementById('button-signup');
        const buttonOtpLogin = document.getElementById('button-otp-login');

        // Function to hide all phases
        function hideAllPhases() {
            phase1Content.style.display = 'none';
            phase2Content.style.display = 'none';
            phase3Content.style.display = 'none';
        }

        // Show Phase 1 (Student Login with Password)
        buttonLoginPassword.addEventListener('click', function (e) {
            e.preventDefault(); // Prevent default button behavior
            hideAllPhases();
            phase1Content.style.display = 'block'; // Show phase 1
        });

        // Show Phase 2 (Student Sign Up)
        buttonSignup.addEventListener('click', function (e) {
            e.preventDefault(); // Prevent default button behavior
            hideAllPhases();
            phase2Content.style.display = 'block'; // Show phase 2
        });

        // Show Phase 3 (Student Login OTP)
        buttonOtpLogin.addEventListener('click', function (e) {
            e.preventDefault(); // Prevent default button behavior
            hideAllPhases();
            phase3Content.style.display = 'block'; // Show phase 3
        });

        // Optional: Add close functionality to close the modal
        const closeButtons = document.querySelectorAll('.close');
        closeButtons.forEach(function (closeButton) {
            closeButton.addEventListener('click', function () {
                hideAllPhases(); // Hide all content when modal is closed
            });
        });
    });
</script>

