                                    var startIndex = blogs.length - 6 >= 0 ? blogs.length - 6 : 0;
                                    %>
                                    <% for (var i = blogs.length - 1; i >= startIndex; i--) { %>
                                        <% 
                                          // Parse the createdAt date
                                          const createdAtDate = new Date(blogs[i].createdAt);
                                          
                                          // Calculate the difference in time from now (in milliseconds)
                                          const now = new Date();
                                          const diffTime = now - createdAtDate;
                                          
                                          // Convert the difference to minutes, hours, and days
                                          const diffMinutes = Math.floor(diffTime / (1000 * 60));
                                          const diffHours = Math.floor(diffTime / (1000 * 60 * 60));
                                          const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                                      
                                          let timeAgo = "";
                                          
                                          // Format time difference
                                          if (diffMinutes < 60) {
                                            timeAgo = diffMinutes + ' mins ago';
                                          } else if (diffHours < 24) {
                                            timeAgo = diffHours + ' hours ago';
                                          } else {
                                            timeAgo = diffDays + ' days ago';
                                          }
                                        %>
                                <div class="swiper-slide">
                                    <div class="card-grid-3 hover-up">
                                        <div class="text-center card-grid-3-image">
                                            <a href="/preview_blogs?url_title=<%= blogs[i].url_title %>">
                                                <figure><img alt="jobhub" src="<%= blogs[i].photo ? uploadUrl + blogs[i].photo : 'assets/imgs/blog/img-blog-1.png' %>" /></figure>
                                            </a>
                                        </div>
                                        <div class="card-block-info">
                                            <div class="row">
                                                <div class="col-lg-6 col-6 text-start">
                                                    <span>By Upreak</span>
                                                </div>
                                                <div class="col-lg-6 col-6 text-end">
                                                    <span><%= blogs[i].createdAt %></span>
                                                </div>
                                            </div>
                                            <h5 class="mt-15 heading-md"><a href="/preview_blogs?url_title=<%= blogs[i].url_title %>"><%= blogs[i].heading %></a></h5>
                                            <div class="card-2-bottom mt-50">
                                                <div class="row">
                                                    <div class="col-lg-9 col-8">
                                                        <a href="/preview_blogs?url_title=<%= blogs[i].url_title %>" class="btn btn-border btn-brand-hover">Keep reading</a>
                                                    </div>
                                                    <div class="col-lg-3 text-end col-4">
                                                        <a href="#" class="mt-10 display-block mr-20"><img alt="jobhub" src="assets/imgs/theme/icons/bookmark.svg" /></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                            </div>
                            <div class="swiper-pagination swiper-pagination3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section class="section-box bg-blue-full mt-90 mb-50">
            <div class="container">
                <div class="row text-center justify-content-center">
                    <h3 class="mb-20">Empower your career with Upreak today? <br>Let's get started right now.</h3>
                    
                    <div class="col-lg-12">
                        <a href="/auth/google" class="btn btn-border icon-chevron-right" style="background-image: url(data:image/svg+xml;base64,);">Continue with Google</a>   
                        <a href="/page-about" class="btn btn-border icon-chevron-right">Know more</a>
                    </div>
                </div>
            </div>
        </section>
        
    <!-- End Content -->
<%- include('includes/footer') %>