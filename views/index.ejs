                <div class="mt-70">
                    <div class="tab-content" id="myTabContent-1">
                        <div class="tab-pane fade show active" id="tab-one-1" role="tabpanel" aria-labelledby="tab-one-1">
                            <div class="row">
                                <% 
                                    // Calculate the starting index for the last 6 items
                                    var startIndex = locals.length - 6 >= 0 ? locals.length - 6 : 0;
                                    %>
                                    <% for (var i = locals.length - 1; i >= startIndex; i--) { %>
                                        <% 
                                          // Parse the createdAt date
                                          const createdAtDate = new Date(locals[i].createdAt);
                                          
                                          // Calculate the difference in time from now (in milliseconds)
                                          const now = new Date();
                                          const diffTime = now - createdAtDate;
                                          
                                          // Convert the difference to minutes, hours, and days
                                          const diffMinutes = Math.floor(diffTime / (1000 * 60));
                                          const diffHours = Math.floor(diffTime / (1000 * 60 * 60));
                                          const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                                      
                                          let timeAgo = "";
                                          
                                          // Format time difference
                                          if (diffMinutes < 60) {
                                            timeAgo = diffMinutes + ' mins ago';
                                          } else if (diffHours < 24) {
                                            timeAgo = diffHours + ' hours ago';
                                          } else {
                                            timeAgo = diffDays + ' days ago';
                                          }
                                        %>
                                        
                                        <!-- Display the time ago message for the last 6 items -->
                                        
                                        <div class="col-lg-4 col-md-6">
                                            <div class="card-grid-2 hover-up">
                                                <div class="text-center card-grid-2-image">
                                                                                                      
                                                    <% if (diffDays <= 3) { %>
                                                        <label class="btn-urgent">Actively Hiring</label>
                                                    <% } %>
                                                </div>
                                                
                                                <div class="card-block-info">
                                                    <% if (diffDays <= 3) { %>
                                                        <label class="btn-urgent">Actively Hiring</label>
                                                    <% } %>
                                                    <div class="row">
                                                        <div class="col-lg-7 col-6">
                                                            <a href="/" class="card-2-img-text" style="padding: 6px 0px 4px 0px !important;">
                                                                <span >Upreak , In</span>
                                                            </a>
                                                        </div>
                                                        <div class="col-lg-5 col-6 text-end">
                                                            <a href="/" class="btn btn-grey-small disc-btn"><%= locals[i].job_type %></a>
                                                        </div>
                                                    </div>
                                                    <h5 class="mt-5"><a href="/job-details?jobId=<%= locals[i].job_id %>"><%= locals[i].heading %></a></h5>
                                                    <div class="mt-15">
                                                        <span class="card-time"><%= timeAgo %></span>
                                                        <span class="card-location"><%= locals[i].location %> , India</span>
                                                    </div>
                                                    <div class="card-2-bottom mt-30">
                                                        <div class="row">
                                                            <div class="col-lg-7 col-8">
                                                                <span class="card-text-price fs-6"> <%= locals[i].amount %><span></span> </span>
                                                            </div>
                                                            <div class="col-lg-5 col-4 text-end">
                                                                <span><img src="assets/imgs/theme/icons/shield-check.svg" alt="jobhub" /></span>
                                                                <span class="ml-5"><img src="assets/imgs/theme/icons/bookmark.svg" alt="jobhub" /></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                      <% } %>
                               
                            </div>
                        </div>
                        <div class="tab-pane fade" id="tab-two-1" role="tabpanel" aria-labelledby="tab-two-1">
                            <div class="row">
                                <div class="col-lg-4 col-md-6">
                                    <div class="card-grid-2 hover-up">
                                        <div class="text-center card-grid-2-image">
