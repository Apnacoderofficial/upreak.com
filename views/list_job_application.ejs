                  <div class="row">

                    



                    <div class="col-md-12 ">
                        <div class="card shadow mb-4">
                          <div class="card-header">
                            <div class="row ">
                              <h5 class="col pt-2">Job Applications</h5>
                              <% if(locals && locals.length > 0) {%>
                              <a href="/export/job_applications" class="btn btn-primary col-md-offset-6 mx-1" style="float: right;">Export</a>
                              <% } %>
                          </div>
                          </div>
                        <div class="card-body p-2 w-100">
                                <table  class="table  table-striped display table-responsive  expandable-table"  width="100%" cellspacing="0">
                                    <thead class="table-light">
                                        <tr class=" text-center">
                                            <th>SNo.</th>
                                            <th>Job Heading</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone Number</th>
                                            <th>Created At</th>
                                            <th>Status</th>
                                            <th>Resume</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                      <% for (var i = 0;i < locals.length ; i++) {%>
                                            <tr>
                                                <td><%= i+1 %></td>
                                                <td><%= getJobHeading(locals[i].job_id, jobs) %></td>
                                                <td><%= locals[i].name %></td>
                                                <td><%= locals[i].email %></td>
                                                <td><%= locals[i].phone_number %></td>
                                                <td><%= locals[i].createdAt %></td>                                                
                                                <td>
                                                  <select name="jobStatus" 
                                                          id="jobStatus_<%= locals[i].id %>" 
                                                          style="font-size: 12px; padding: 2px; width: 120px;"
                                                          onchange="updateJobStatus('<%= locals[i].id %>', this.value)" 
                                                          <%= locals[i].status == 8 ? 'disabled' : '' %> >
                                                          
                                                    <% const statuses = {1: 'Application Sent', 2: 'Application Viewed', 3: 'Resume Viewed', 4: 'Awaiting Recruiter Action', 5: 'Recruiter Seen', 6: 'Application Sent to Round', 7: 'Hired', 8: 'Rejected'}; %>
                                                    
                                                    <% for (let status in statuses) { %>
                                                      <option value="<%= status %>" <%= locals[i].status == status ? 'selected' : '' %>>
                                                        <%= statuses[status] %>
                                                      </option>
                                                    <% } %>
                                                  </select>
                                                </td>
                                                
                                                
                                                <td>
                                                  <% if (locals[i].resume_link && locals[i].resume_link.publicUrls) { %>
                                                    <a class="btn m-1 btn-outline-info" href="<%= locals[i].resume_link.publicUrls %>" target="_blank">View Resume</a>
                                                    <!-- <a class="btn m-1 btn-outline-info" href="/download_resume?id=<%= locals[i].id %>">Download</a> -->
                                                  <% } else if (locals[i].resume) { %>
                                                    <a class="btn m-1 btn-outline-info" href="/uploads/<%= locals[i].resume %>">Resume</a>
                                                  <% } else { %>
                                                    No Resume Found
                                                  <% } %>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                    </tfoot>
                                </table>
                            
                        </div>
                  
                        <% function getJobHeading(jobId, jobs) {
                            for (let j = 0; j < jobs.length; j++) {
                              if (jobs[j].job_id === jobId) {
                                return jobs[j].heading; // or jobs[j].title or any field that contains the heading
                              }
                            }
                            return "Job Deleted"; // Fallback if jobId is not found
                          }
                       %>
                        </div>
                      </div>
                    </div>
                </div>
         
      
                  <!-- content-wrapper ends -->
                  <!-- partial:partials/_footer.html -->
                  <%- include('includes/footer.ejs') %>
                  <!-- Include jQuery CDN -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Include Toastr CDN for notifications -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

                  <script>
                    function updateJobStatus(id, status) {
                      $.ajax({
                        url: '/updateJobStatus', // The route to handle the update
                        method: 'POST',
                        data: {
                          id: id,
                          status: status
                        },
                        success: function(response) {
                          if (response.success) {
                            toastr.success('Status updated successfully.');
                          } else {
                            toastr.error('Failed to update status.');
                          }
                        },
                        error: function() {
                          toastr.error('An error occurred while updating status.');
                        }
                      });
                    }
                  </script>
                  
                  
                  
                  
                  <!-- partial -->
                </div>
                <!-- main-panel ends -->
              </div>
              <!-- page-body-wrapper ends -->
            </div>
