      <h1 class="custom-heading animate mb-2">Find your dream job now!</h1>
      <p class="text-center custom-para animate">We’re always searching for amazing people. Take a look at our current openings.</p>
      <!-- <div class="d-flex justify-content-center align-items-center text-center">
        <a href="services" class="btn-lg btn-dark text-white explore-btn mr-1 explore">Explore More</a>
        <a href="signup" class="btn-lg btn-outline-dark border explore-btn ml-1 start">Get Start Now</a>
      </div> -->
      </div>

    <div class="job-listing-area pt-50 pb-120" id="jobs">
      <div class="container-fluid">
          <div class="row">
              <!-- Left content -->
              <div class="col-xl-3 col-lg-3 col-md-4  p-3" >
                  <div class="row">
                      <div class="col-12">
                              <div class="small-section-tittle2 mb-45">
                              <div class="ion"> <svg 
                                  xmlns="http://www.w3.org/2000/svg"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  width="20px" height="12px">
                              <path fill-rule="evenodd"  fill="rgb(27, 207, 107)"
                                  d="M7.778,12.000 L12.222,12.000 L12.222,10.000 L7.778,10.000 L7.778,12.000 ZM-0.000,-0.000 L-0.000,2.000 L20.000,2.000 L20.000,-0.000 L-0.000,-0.000 ZM3.333,7.000 L16.667,7.000 L16.667,5.000 L3.333,5.000 L3.333,7.000 Z"/>
                              </svg>
                            </div>
                            <h4>Filter Jobs</h4>
                          </div>
                      </div>
                  </div>    
                    <form id="filterForm" action="/jobs" method="POST">
                        <!-- Job Category Listing start -->
                        <div class="job-category-listing mb-10 p-3  bg-white"style="border-radius: 15px;">
                            <!-- single one -->
                            <div class="single-listing">
                                <!-- select-Categories start -->
                                <div class="select-Categories pt-1 pb-10">
                                    <div class="small-section-tittle2">
                                        <h4>Job Type</h4>
                                    </div>
                                    <select id="job_type" name="job_type" class="form-control">
                                    <option value="">Select Job Type</option>
                                    <option value="Full Time"<%= typeof bData != 'undefined' ? (!!bData.job_type) ?  bData.job_type === 'Full Time' ? 'selected' : '' :  '' : '' %>>Full Time</option>
                                    <option value="Part Time"<%= typeof bData != 'undefined' ? (!!bData.job_type) ?  bData.job_type === 'Part Time' ? 'selected' : '' :  '' : '' %>>Part Time</option>
                                    <option value="Remote"<%= typeof bData != 'undefined' ? (!!bData.job_type) ?  bData.job_type === 'Remote' ? 'selected' : '' :  '' : '' %>>Remote</option>
                                    <option value="Freelance"<%= typeof bData != 'undefined' ? (!!bData.job_type) ?  bData.job_type === 'Freelance' ? 'selected' : '' :  '' : '' %>>Freelance</option>
                                </select>
                                </div>
                                <!-- select-Categories End -->
                            </div>
                            <!-- single two -->
                            <div class="single-listing ">
                                <div class="small-section-tittle2">
                                    <h4>Job Location</h4>
                                </div>
                                <!-- Select job items start -->
                                <div class="select-job-items2 ">
                                <input type="text" id="location" name="location" class="form-control" autocomplete="off" placeholder="Enter Location" value="<%- typeof bData != 'undefined' ? bData.location : '' %>" >
                                </div> 
                                <!--  Select job items End-->
                                <!-- select-Categories start -->
                               <div class="select-Categories pt-10 pb-10">
                                    <div class="small-section-tittle2">
                                        <h4>Experience</h4>
                                    </div>
                                    <select id="experience" name="experience" class="form-control">
                                    <option value="">Select Experience</option>
                                    <option value="0"<%= typeof bData != 'undefined' ? (!!bData.experience) ?  bData.experience === '0' ? 'selected' : '' :  '' : '' %>>Fresher</option>
                                    <option value="1"<%= typeof bData != 'undefined' ? (!!bData.experience) ?  bData.experience === '1' ? 'selected' : '' :  '' : '' %>>Experience</option>
                                </select>
                                </div>
                                <!-- select-Categories End -->
                            </div>
                            <!-- single three -->
                            <div class="single-listing">
                                <!-- select-Categories start -->
                                <div class="select-Categories pb-10">
                                    <div class="small-section-tittle2">
                                        <h4>Posted Within</h4>
                                    </div>
                                    <select id="createdAt" name="createdAt" class="form-control">
                                    <option value="">Select Posted Date</option>
                                    <option value="0"<%= typeof bData != 'undefined' ? (!!bData.createdAt) ?  bData.createdAt === '0' ? 'selected' : '' :  '' : '' %>>Today</option>
                                    <option value="1"<%= typeof bData != 'undefined' ? (!!bData.createdAt) ?  bData.createdAt === '1' ? 'selected' : '' :  '' : '' %>>This Month</option>
                                    <option value="2"<%= typeof bData != 'undefined' ? (!!bData.createdAt) ?  bData.createdAt === '2' ? 'selected' : '' :  '' : '' %>>Older</option>
                                </select>
                                </div>
                                <!-- select-Categories End -->
                            </div>
                            <div class="col-md-12 mt-4 mx-5 justify-content-center mx-auto">
                                <button type="submit" class="btn btn-success me-2">Apply Now</button>
                                <a href="/jobs" class="btn btn-outline-secondary ">Reset</a>
                              </div>
                        </div>
                        <div class="job-category-listing mb-10 p-3 bg-white ad-content" style="border-radius: 15px;">
                            <div class="">
                                
                                <div class="ad-text">
                                    <h3>Create a Professional Resume in Minutes!</h3>
                                    <p>Stand out from the crowd with a resume that showcases your strengths. Our easy-to-use resume builder helps you craft a polished and professional resume in just a few clicks. No design skills needed!</p>
                                    <a href="/resume-builder" class="ad-button text-right">Try It Now >></a>
                                </div>
                            </div>
                        </div>
                        
                        
                        <div class="job-category-listing mb-10 p-3 bg-white" style="border-radius: 15px;">
                            <div class="ad-text">
                                <h5>For More Updates, Join Our Groups Now!</h5>
                                <a href="https://whatsapp.com/channel/0029VakqglnFnSzBl9TPPs0t" class="whatsapp-join-btn" target="_blank">
                                    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WhatsApp Logo" class="whatsapp-logo">
                                    Join WhatsApp Group
                                </a>
                            </div>
                        </div>
                        
                    </form>
                    
                    
                  <!-- Job Category Listing End -->
              </div>
              <!-- Right content -->
              <style>
                .pagination-controls {
                    text-align: center;
                    margin-top: 20px;
                }
                .pagination-controls button {
                    margin: 0 5px;
                    padding: 5px 10px;
                    background-color: #007bff;
                    color: white;
                    border: none;
                    border-radius: 5px;
                    cursor: pointer;
                }
                .pagination-controls button:disabled {
                    background-color: #cccccc;
                    cursor: not-allowed;
                }
            </style>
            <div class="col-xl-9 col-lg-9 col-md-8">
                <section class="featured-job-area">
                    <div class="containerfluid">
                        <!-- Count of Job list Start -->
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="count-job mb-35">
                                    <span><%= locals.length %> Jobs Found</span>
                                </div>
                            </div>
                        </div>
                        <!-- Count of Job list End -->
                        <!-- single-job-content -->
                        
            
                        <!-- Hidden container for all jobs -->
                        <div id="all-jobs" >
                            <% locals.forEach(job => { %>
                                <a href="/job_details?jobId=<%= job.job_id %>" class="job-item">
                                    <div class="single-job-items mb-20 border-bottom border-5 shadow" style="border-radius: 15px;">
                                        <div class="job-items">
                                            <div class="company-img">
                                                <img src="../uploads/<%= job.photo %>" alt="Logo" width="80" height="80">
                                            </div>
                                            <div class="job-tittle job-tittle2">
                                                <h4 class="truncated-heading"><%= job.heading %></h4>
                                                <ul>
                                                    <li><%= job.job_type %></li> &nbsp;
                                                    <li>
                                                        <i class="fas fa-map-marker-alt"></i>
                                                        <%= job.location.split(',').join(', ') %>
                                                    </li>
                                                    <li><%= job.amount %></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="items-link items-link2 f-right">
                                            <% if (job.status == 1) { %>
                                                <a class="btn btn-success text-white" href="/job_details?jobId=<%= job.job_id %>">Apply</a>
                                            <% } else { %>
                                                <strong>Closed</strong>
                                            <% } %>
                                            <span><%= job.createdAt %></span>
                                        </div>
                                    </div>
                                </a>
                            <% }); %>
                        </div>
            
                        <!-- Pagination Controls -->
                        <div class="pagination-controls">
                            <button id="prev-page">Previous</button>
                            <span id="page-info">Page 1</span>
                            <button id="next-page">Next</button>
                        </div>
                    </div>
                </section>
            </div>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        const jobsPerPage = 20;
        let currentPage = 1;

        // Convert HTML to an array of job items
        const jobItems = $('#all-jobs').children().toArray();
        const totalJobs = jobItems.length;

        function renderJobs(page) {
            const startIndex = (page - 1) * jobsPerPage;
            const endIndex = startIndex + jobsPerPage;
            const jobsToDisplay = jobItems.slice(startIndex, endIndex);

            // Clear previous jobs and append new ones
            $('#all-jobs').html('');
            $('#all-jobs').append(jobsToDisplay);

            $('#page-info').text(`Page ${currentPage}`);
            $('#prev-page').prop('disabled', currentPage === 1);
            $('#next-page').prop('disabled', currentPage === Math.ceil(totalJobs / jobsPerPage));
            $('#job-count').text(`${totalJobs} Jobs Found`);
        }

        $('#prev-page').click(function () {
            if (currentPage > 1) {
                currentPage--;
                renderJobs(currentPage);
            }
        });

        $('#next-page').click(function () {
            if (currentPage < Math.ceil(totalJobs / jobsPerPage)) {
                currentPage++;
                renderJobs(currentPage);
            }
        });

        renderJobs(currentPage); // Initial render
    });
</script>

            

            

            


              
          </div>
      </div>
  </div>
    
