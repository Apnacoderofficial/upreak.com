<%- include('includes/header') %>
<title><%= title%> - Upreak A leading recruitment company</title>
<!-- Content -->
<main class="main">

    <%- include('includes/user_header') %>

    <section class="section-box mt-80">
        <div class="container">
            <div class="row flex-row-reverse">
                <div class="col-lg-9 col-md-12 col-sm-12 col-12 float-right">
                    <div class="content-page">
                        <div class="box-filters-job mt-15 mb-10">
                            <div class="row">
                                <div class="col-lg-7">
                                    <span class="text-small fs-3">
                                        <%= title %>
                                    </span>
                                </div>

                                <div class="col-lg-5 text-lg-end mt-sm-15">
                                    <div class="display-flex2">
                                        <div class="box-view-type">
                                            <a href="job-list" class="view-type"><img
                                                    src="/assets/imgs/theme/icons/icon-list.svg" alt="jobhub" /></a>
                                            <!-- <a href="job-list" class="view-type"><img src="/assets/imgs/theme/icons/icon-grid.svg" alt="jobhub" /></a> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="job-list-list mb-15">
                            <div class="list-recent-jobs">
                              <!-- Include DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">

<!-- Table HTML -->
<div class="table-responsive">
    <table id="reportTable" class="table table-striped display expandable-table" width="100%" cellspacing="0">
        <thead class="table-light">
            <tr class="text-center">
                <th>SNo.</th>
                <th>Candidate Name</th>
                <th>Candidate Email</th>
                <th>View Report</th>
                <th>Interviewed On</th>
                <th>Report Created At</th>
            </tr>
        </thead>
        <tbody>
            <% if (report.length > 0) { %>
                <% for (var i = 0; i < report.length; i++) { %>
                    <% if (report[i].candidateemail == user.emailid) { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= report[i].candidatename %></td>
                            <td><%= report[i].candidateemail %></td>
                            <td>
                                <a href="view_report/<%= report[i].id %>" class="btn btn-success text-white" onclick="checkMobile(event)">
                                    <i class="fa fa-solid fa-eye"></i>
                                </a>
                            </td>
                            <td><%= report[i].createdAt %></td>
                            <td><%= report[i].updatedAt %></td>
                        </tr>
                    <% } %>
                <% } %>
            <% } else { %>
                <tr>
                    <td colspan="6" class="text-center">No data found</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>


<!-- Include jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Include DataTables JS -->
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

<!-- Include DataTables Buttons extension for exporting -->
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js"></script>

<!-- Initialize DataTable with export and search features -->
<script>
    $(document).ready(function() {
        $('#reportTable').DataTable({
            "paging": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "autoWidth": false,
            "lengthChange": true,  // Allows user to change the number of rows displayed
            "pageLength": 10,      // Default number of rows
            "order": [[ 4, 'desc' ]],  // Sort by Interviewed On date column
            "dom": 'Bfrtip',       // Defines the table control elements
            "buttons": [
                'copy', 'excel', 'pdf', 'print'
            ]
        });
    });
</script>

                                  
                            </div>
                        </div>

                    </div>
                </div>
                <%- include('includes/sidebar') %>
            </div>
        </div>
    </section>


    <%- include('includes/footer') %>